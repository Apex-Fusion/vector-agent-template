# ── Identity ──────────────────────────────────────────────
# All four keys below come from one run of gen-keypair.ts against the
# network you're deploying to:
#   corepack pnpm --filter @marketplace/supplier exec tsx src/cli/gen-keypair.ts --network 1
# It prints one JSON object - map its fields to these env vars:
#   privateKeyHex -> SUPPLIER_PRIV_KEY_HEX
#   publicKeyHex  -> SUPPLIER_PUB_KEY_HEX
#   pubKeyHash    -> SUPPLIER_PKH
#   address       -> SUPPLIER_ADDRESS
# 64-hex ed25519 private key
SUPPLIER_PRIV_KEY_HEX=
# 64-hex ed25519 public key - served at /capability; empty breaks buyer receipt verification
SUPPLIER_PUB_KEY_HEX=
# 56-hex blake2b-224 hash of the public key - must match the escrow's supplier_pkh or job claims fail wrong_supplier ("escrow supplier_pkh does not match this node")
SUPPLIER_PKH=
# bech32 enterprise address derived from the same key
SUPPLIER_ADDRESS=
# ── Chain ─────────────────────────────────────────────────
NETWORK_ID=1
OGMIOS_URL=https://ogmios.vector.mainnet.apexfusion.org   # https, not wss
VECTOR_ZERO_TIME_MS=1756485600000                         # required on mainnet
LIVE_CHAIN=1                                              # literal "1" enables chain writes
# <txhash>#0 - printed by post-advert
ADVERT_REF=
# Reference scripts of the legacy escrow and advert. Keep them while legacy
# escrows exist (the drain); the escrow and advert with an agent_id use the
# IDENTITY_* pair below.
ESCROW_REF_UTXO=c8d84c6d67ec67a1efe5e9c6c06d53020e05d1bb96d1c55ecb1eb7d5010c4d54#0
ADVERT_REF_UTXO=c8d84c6d67ec67a1efe5e9c6c06d53020e05d1bb96d1c55ecb1eb7d5010c4d54#1
# ── Agent record (identity registry) ──────────────────────
# The identity registry deployment publishes the next four values. Until
# then leave them empty: the agent then serves legacy escrows only.
# Policy ID of the identity registry (56 hex). Needed to register the record,
# to post an advert with your AGENT_ID, and to work escrows that name it.
IDENTITY_POLICY_ID=
# <txhash>#<index> of the identity contract's reference script. Read only by
# register-record.ts build.
IDENTITY_REF_UTXO=
# <txhash>#<index> reference scripts of the escrow and advert that carry an
# agent_id. Empty: the transactions carry the scripts inline (higher fees).
IDENTITY_ESCROW_REF_UTXO=
IDENTITY_ADVERT_REF_UTXO=
# Your agent: the AGENT_ID=<64 hex> line that register-record.ts submit
# prints. post-advert.ts writes it into the advert, and the agent works only
# escrows that name it. Empty: legacy adverts and escrows only.
AGENT_ID=
# Public key (64 hex) of the record's controller: the publicKeyHex of a
# SEPARATE gen-keypair run whose private key stays offline. Read only by
# register-record.ts build.
IDENTITY_CONTROLLER_PUB_KEY_HEX=
# The record's Accountable Party: "controller" (the default), or the 56-hex
# key hash of another key, which then also signs the registration.
IDENTITY_ACCOUNTABLE_PARTY=controller
# ── Your black box ────────────────────────────────────────
CAPABILITY_KIND=custom
# your service; try examples/echo-service.mjs first. Under docker compose use
# http://echo:9091 instead - in a container 127.0.0.1 is the container itself
SERVICE_URL=http://127.0.0.1:9091
SERVICE_TIMEOUT_MS=120000         # must be < advert SLA - 30000 (boot-enforced)
ADVERT_MAX_PROCESSING_MS=300000   # your advert's SLA; REQUIRED for CAPABILITY_KIND=custom; boot refuses unless SERVICE_TIMEOUT_MS < this - 30000
# optional, sent as Authorization
SERVICE_AUTH_HEADER=
SERVICE_CONTENT_TYPE=application/json
# ── Ops ───────────────────────────────────────────────────
PORT=8080
WALLET_HEALTH_INTERVAL_MS=45000
# ── try-it: the self-test buyer ───────────────────────────
# Read ONLY by try-it/src/buy-once.ts, never by the agent. It is a SECOND
# wallet: run gen-keypair again, fund it as its own 5 + working pair, and put
# that run's privateKeyHex here. try-it also reads OGMIOS_URL, NETWORK_ID,
# VECTOR_ZERO_TIME_MS, IDENTITY_POLICY_ID and IDENTITY_ESCROW_REF_UTXO from
# the blocks above.
BUYER_PRIV_KEY_HEX=
# Indexer that must list an advert with an agent_id before try-it posts its
# escrow. Empty: the public mainnet indexer (NETWORK_ID=1 only).
INDEXER_URL=
# The announced escrow switch slot. From this chain slot on, try-it refuses a
# legacy advert, because the marketplace no longer lists it. Empty: no switch.
SWITCH_SLOT=
