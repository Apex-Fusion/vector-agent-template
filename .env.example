# ── Identity ──────────────────────────────────────────────
# All four keys below come from one run of gen-keypair.ts against the
# network you're deploying to:
#   corepack pnpm --filter @marketplace/supplier exec tsx src/cli/gen-keypair.ts --network 1
# It prints one JSON object - map its fields to these env vars:
#   privateKeyHex -> SUPPLIER_PRIV_KEY_HEX
#   publicKeyHex  -> SUPPLIER_PUB_KEY_HEX
#   pubKeyHash    -> SUPPLIER_PKH
#   address       -> SUPPLIER_ADDRESS
# 64-hex ed25519 private key
SUPPLIER_PRIV_KEY_HEX=
# 64-hex ed25519 public key - served at /capability; empty breaks buyer receipt verification
SUPPLIER_PUB_KEY_HEX=
# 56-hex blake2b-224 hash of the public key - must match the escrow's supplier_pkh or job claims fail wrong_supplier ("escrow supplier_pkh does not match this node")
SUPPLIER_PKH=
# bech32 enterprise address derived from the same key
SUPPLIER_ADDRESS=
# ── Chain ─────────────────────────────────────────────────
NETWORK_ID=1
OGMIOS_URL=https://ogmios.vector.mainnet.apexfusion.org   # https, not wss
VECTOR_ZERO_TIME_MS=1756485600000                         # required on mainnet
LIVE_CHAIN=1                                              # literal "1" enables chain writes
# <txhash>#0 - printed by post-advert
ADVERT_REF=
ESCROW_REF_UTXO=c8d84c6d67ec67a1efe5e9c6c06d53020e05d1bb96d1c55ecb1eb7d5010c4d54#0
ADVERT_REF_UTXO=c8d84c6d67ec67a1efe5e9c6c06d53020e05d1bb96d1c55ecb1eb7d5010c4d54#1
# ── Your black box ────────────────────────────────────────
CAPABILITY_KIND=custom
SERVICE_URL=http://127.0.0.1:9091 # your service; try examples/echo-service.mjs first
SERVICE_TIMEOUT_MS=120000         # must be < advert SLA - 30000 (boot-enforced)
ADVERT_MAX_PROCESSING_MS=300000   # your advert's SLA; REQUIRED for CAPABILITY_KIND=custom; boot refuses unless SERVICE_TIMEOUT_MS < this - 30000
# optional, sent as Authorization
SERVICE_AUTH_HEADER=
SERVICE_CONTENT_TYPE=application/json
# ── Ops ───────────────────────────────────────────────────
PORT=8080
WALLET_HEALTH_INTERVAL_MS=45000
